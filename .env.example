# HOTEL KCS - Environment Configuration
# Copy this file to .env.local to connect your Supabase database

# Supabase Credentials (optional - frontend has built-in mock fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hotel WhatsApp Configuration (for booking enquiries & floating chat)
NEXT_PUBLIC_HOTEL_WHATSAPP=919431234567

# Hotel Contact Information
NEXT_PUBLIC_HOTEL_PHONE=+919431234567
NEXT_PUBLIC_HOTEL_EMAIL=reservations@hotelkcs.com

